<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical" android:background="@drawable/kuwenta_widget_background">
 <TextView android:id="@+id/kuwenta_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="@string/kuwenta_widget_title" android:textColor="#DCFCE7" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:paddingBottom="8dp" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
 <TextView android:id="@+id/kuwenta_widget_expense" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"
 android:layout_marginStart="0dp" android:gravity="center" android:background="@drawable/kuwenta_widget_action"
 android:text="@string/kuwenta_widget_expense" android:textColor="#064C32" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"
 android:maxLines="1" android:ellipsize="end" android:drawableTop="@drawable/kuwenta_widget_expense" android:drawablePadding="3dp" android:padding="4dp" />
 <TextView android:id="@+id/kuwenta_widget_income" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"
 android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/kuwenta_widget_action"
 android:text="@string/kuwenta_widget_income" android:textColor="#064C32" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"
 android:maxLines="1" android:ellipsize="end" android:drawableTop="@drawable/kuwenta_widget_income" android:drawablePadding="3dp" android:padding="4dp" />
 <TextView android:id="@+id/kuwenta_widget_quick" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"
 android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/kuwenta_widget_action"
 android:text="@string/kuwenta_widget_quick" android:textColor="#064C32" android:textSize="11sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold"
 android:maxLines="1" android:ellipsize="end" android:drawableTop="@drawable/kuwenta_widget_quick" android:drawablePadding="3dp" android:padding="4dp" />
 </LinearLayout>
</LinearLayout>
