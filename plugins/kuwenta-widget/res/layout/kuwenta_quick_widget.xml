<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="14dp" android:background="@drawable/kuwenta_widget_background">
 <TextView android:id="@+id/kuwenta_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="@string/kuwenta_widget_title" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="10dp" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
 <TextView android:id="@+id/kuwenta_widget_expense" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp"
 android:layout_marginStart="0dp" android:gravity="center" android:background="@drawable/kuwenta_widget_action"
 android:text="@string/kuwenta_widget_expense" android:textColor="#064C32" android:textSize="12sp" android:textStyle="bold"
 android:maxLines="1" android:ellipsize="end" android:drawableTop="@drawable/kuwenta_widget_expense" android:drawablePadding="4dp" android:padding="6dp" />
 <TextView android:id="@+id/kuwenta_widget_income" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp"
 android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/kuwenta_widget_action"
 android:text="@string/kuwenta_widget_income" android:textColor="#064C32" android:textSize="12sp" android:textStyle="bold"
 android:maxLines="1" android:ellipsize="end" android:drawableTop="@drawable/kuwenta_widget_income" android:drawablePadding="4dp" android:padding="6dp" />
 <TextView android:id="@+id/kuwenta_widget_quick" android:layout_width="0dp" android:layout_weight="1" android:layout_height="60dp"
 android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/kuwenta_widget_action"
 android:text="@string/kuwenta_widget_quick" android:textColor="#064C32" android:textSize="12sp" android:textStyle="bold"
 android:maxLines="1" android:ellipsize="end" android:drawableTop="@drawable/kuwenta_widget_quick" android:drawablePadding="4dp" android:padding="6dp" />
 </LinearLayout>
</LinearLayout>
