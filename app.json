{
  "expo": {
    "name": "Kuwenta",
    "slug": "Kuwenta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kuwenta-app-icon.png",
    "scheme": "kuwenta",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/kuwenta-app-icon.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.iemdomain04.Kuwenta",
      "icon": "./assets/images/kuwenta-app-icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kuwenta-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38bef72f-a088-42e4-b4e2-7de21a8d8e52"
      }
    }
  }
}
