{
  "expo": {
    "name": "Kuwenta",
    "slug": "Kuwenta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kuwenta-app-icon.png",
    "scheme": "kuwenta",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/kuwenta-app-icon.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.iemdomain04.Kuwenta",
      "icon": "./assets/images/kuwenta-app-icon.png",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kuwenta-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06633E",
          "dark": {
            "backgroundColor": "#0C1711"
          },
          "image": "./assets/images/kuwenta-app-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "@react-native-vector-icons/ionicons",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-notifications",
      "./plugins/kuwenta-widget/with-kuwenta-widget",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": false
        }
      ],
      "./plugins/with-private-backup"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "src/features/finance/native"
        ]
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38bef72f-a088-42e4-b4e2-7de21a8d8e52"
      }
    }
  }
}
